# vllm serve arguments after the model path, one per line (launch.sh adds --host/--port)
--served-model-name
qwen3.8-flash-next
--trust-remote-code
--quantization
modelopt
--tensor-parallel-size
1
--max-model-len
262144
--max-num-seqs
6
--gpu-memory-utilization
0.80
--max-num-batched-tokens
4096
--engram-config
{"host_file_gather": true}
--compilation-config
{"mode": 0, "cudagraph_mode": "FULL_DECODE_ONLY"}
--no-enable-flashinfer-autotune
--reasoning-parser
qwen3
--enable-auto-tool-choice
--tool-call-parser
qwen3_xml
--default-chat-template-kwargs
{"enable_thinking": false}
--kv-cache-dtype
fp8_e4m3
--kv-cache-dtype-skip-layers
48
--mamba-ssm-cache-dtype
bfloat16
--enable-prefix-caching
--speculative-config
{"method": "mtp", "num_speculative_tokens": 4, "draft_lm_head_quantization": "nvfp4", "num_speculative_tokens_per_batch_size": [[1, 1, 4], [2, 6, 3]]}
