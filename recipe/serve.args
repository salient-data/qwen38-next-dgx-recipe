# vllm serve arguments after the model path, one per line (launch.sh adds --host/--port)
--served-model-name
qwen3.8-flash-next
--trust-remote-code
--quantization
modelopt
--tensor-parallel-size
1
--max-model-len
262144
--max-num-seqs
6
--gpu-memory-utilization
0.80
--max-num-batched-tokens
4096
--engram-config
{"host_file_gather": true}
--compilation-config
{"mode": 0, "cudagraph_mode": "FULL_DECODE_ONLY"}
--no-enable-flashinfer-autotune
--reasoning-parser
qwen3
--enable-auto-tool-choice
--tool-call-parser
qwen3_xml
--default-chat-template-kwargs
{"enable_thinking": false}
--kv-cache-dtype
fp8_e4m3
--use-replayssm
--kv-cache-dtype-skip-layers
48
--mamba-ssm-cache-dtype
bfloat16
--enable-prefix-caching
--speculative-config
{"method": "mtp", "num_speculative_tokens": 6, "draft_confidence_threshold": 0.7, "draft_confidence_fallback_depth": 3, "draft_token_map": "/root/.cache/draft-token-maps/d22ff5232d12f6935add32541a2a447976349217e5b125669fab0e92e3e2a20b.json", "draft_token_map_dynamic_rows": 16384, "draft_token_map_dynamic_rank": 256, "draft_token_map_quantization": "nvfp4"}
