+        """
+        spec = getattr(self.vllm_config, "speculative_config", None)
+        limit = getattr(spec, "draft_token_map_max_rows", None)
+        use = limit is None or rows <= limit
+        seen = self.__dict__.setdefault("_token_map_rows_logged", set())
