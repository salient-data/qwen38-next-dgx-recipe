+# Casts that represent every source value exactly: loading through them changes nothing,
+# so they are not worth a warning (e.g. a BF16 A_log into vLLM's FP32 parameter).
+_EXACT_WIDENING = {
+    (torch.bfloat16, torch.float32),
+    (torch.float16, torch.float32),
+    (torch.bfloat16, torch.float64),
+    (torch.float16, torch.float64),
+    (torch.float32, torch.float64),
+}
+
+
+def _is_exact_widening(src: torch.dtype, dst: torch.dtype) -> bool:
+    return (src, dst) in _EXACT_WIDENING
+
