+# QWEN38_FP8_DENSE: cast chosen BF16 linears that this
+# MIXED_PRECISION checkpoint leaves unquantized to 128x128 block FP8 at load,
+# through vLLM's own Fp8PerBlockOnlineLinearMethod -- the scheme FP8_PB_WO
+# checkpoints store. A comma list of groups; unset or empty changes nothing.
+#   gdn      linear_attn.in_proj_qkvz, linear_attn.out_proj
+#   attn     self_attn.qkv_proj, self_attn.o_proj (QSA; not the indexer)
+#   shared   mlp.shared_expert.gate_up_proj, mlp.shared_expert.down_proj
+#   lm_head  the output head (and the MTP head that shares it)
+#   mtp      allow the groups above inside the MTP drafter too
+# Routers, gates, hyper-connection mixes, in_proj_ba, the PLE layer, the
+# indexer and the embeddings stay BF16 whatever is set.
+_QWEN38_FP8_DENSE_PATTERNS = {
+    "gdn": re.compile(r"\.linear_attn\.(in_proj_qkvz|out_proj)$"),
+    "attn": re.compile(r"\.self_attn\.(qkv_proj|o_proj)$"),
+    "shared": re.compile(r"\.mlp\.shared_expert\.(gate_up_proj|down_proj)$"),
+}
+
+
+def _qwen38_fp8_dense_method(
+    layer: torch.nn.Module, prefix: str
+) -> "QuantizeMethodBase | None":
+    groups = {
+        g.strip()
+        for g in os.environ.get("QWEN38_FP8_DENSE", "").split(",")
+        if g.strip()
+    }
+    if not groups:
+        return None
+    unknown = groups - {*_QWEN38_FP8_DENSE_PATTERNS, "lm_head", "mtp"}
+    if unknown:
+        raise ValueError(f"QWEN38_FP8_DENSE: unknown group(s) {sorted(unknown)}")
+    if "mtp" in prefix.split(".") and "mtp" not in groups:
+        return None
+    if isinstance(layer, ParallelLMHead):
+        if "lm_head" not in groups:
+            return None
+    elif not isinstance(layer, LinearBase) or not any(
+        _QWEN38_FP8_DENSE_PATTERNS[g].search(prefix)
+        for g in groups
+        if g in _QWEN38_FP8_DENSE_PATTERNS
+    ):
+        return None
+    if type(layer).__name__ == "Qwen4ExpQSAQKVIndexerLinear":
+        raise ValueError(
+            f"QWEN38_FP8_DENSE: {prefix} carries the indexer Q/K rows, which "
+            "stay BF16; the attn group needs the unfused projections"
+        )
+    from vllm.model_executor.layers.quantization.online.fp8 import (
+        Fp8PerBlockOnlineLinearMethod,
+    )
+
+    logger.info("QWEN38_FP8_DENSE: %s -> block FP8 (online)", prefix)
+    return Fp8PerBlockOnlineLinearMethod()
+
