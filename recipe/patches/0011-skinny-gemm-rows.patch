Patch 0011-skinny-gemm-rows.patch for vLLM, base commit 77154ca6116ae34cbfe314beef1016bde9b63989 (vllm/vllm-openai:nightly-77154ca6116ae34cbfe314beef1016bde9b63989).
What: Plans the SM121 skinny BF16 GEMM for every row count up to its maximum, not only 1, 2, 4, 8 and 16, so a 5- or 7-row speculative verify no longer falls back to a slower generic kernel (QWEN38_SKINNY_FILL=0 turns it off).
Upstream: no vLLM PR. written for this recipe.
This file modifies vLLM (Apache-2.0); the vLLM copyright and SPDX lines in the files it changes are kept.

diff --git a/vllm/models/qwen4_exp/nvidia/low_latency_gemm.py b/vllm/models/qwen4_exp/nvidia/low_latency_gemm.py
index ea56750..fb03cf3 100644
--- a/vllm/models/qwen4_exp/nvidia/low_latency_gemm.py
+++ b/vllm/models/qwen4_exp/nvidia/low_latency_gemm.py
@@ -299,6 +299,26 @@ QWEN4_EXP_SM121_GEMM_PLANS: dict[tuple[int, int], dict[int, SkinnyGemmConfig]] =
 }
 
 
+def _qwen38_fill_row_gaps(plans: dict[tuple[int, int], dict[int, SkinnyGemmConfig]]) -> None:
+    # the plans cover 1, 2, 4, 8 and 16 rows, but a verify step at one request with k=4
+    # has 5 rows (and the k=3 schedule 12, 20 or 24 at 3, 5 or 6 requests), so those steps fell back to
+    # F.linear and cuBLAS's SM80 WMMA kernel. Fill every row count up to the largest planned one with the
+    # next larger plan's tuning at the exact row count. QWEN38_SKINNY_FILL=0 turns this off.
+    import dataclasses
+    import os
+
+    if os.environ.get("QWEN38_SKINNY_FILL", "1") == "0":
+        return
+    for plan in plans.values():
+        planned = sorted(plan)
+        for m in range(1, planned[-1] + 1):
+            if m not in plan:
+                plan[m] = dataclasses.replace(plan[next(p for p in planned if p > m)], num_rows=m)
+
+
+_qwen38_fill_row_gaps(QWEN4_EXP_SM121_GEMM_PLANS)
+
+
 QWEN4_EXP_GEMM_PLANS_BY_CAPABILITY: dict[
     tuple[int, int] | None, dict[tuple[int, int], dict[int, SkinnyGemmConfig]]
 ] = {
