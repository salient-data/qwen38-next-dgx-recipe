Patch 0003-vllm59973-nvfp4-draft-lm-head.patch for vLLM, base commit 8e2beaa3bff595577a069d49d96bde9074294ec2 (vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2).
What: Quantizes the MTP drafter's lm_head (the 65,536 reduced-vocabulary rows) to NVFP4.
Upstream: https://github.com/vllm-project/vllm/pull/59973 by @stecasta (merged), ported at head e037067e; adds the reduced-vocabulary draft-rows hook.
This file modifies vLLM (Apache-2.0); the vLLM copyright and SPDX lines in the files it changes are kept.

diff --git a/vllm/models/qwen4_exp/nvidia/mtp.py b/vllm/models/qwen4_exp/nvidia/mtp.py
index 863a65dd..d500136e 100644
--- a/vllm/models/qwen4_exp/nvidia/mtp.py
+++ b/vllm/models/qwen4_exp/nvidia/mtp.py
@@ -536,6 +536,7 @@ class Qwen4ExpMTP(nn.Module, SupportsHCSP, SupportsPP, Qwen4ExpMixtureOfExperts)
 
     def quantize_draft_rows(self, quantization: str) -> None:
         from vllm.logger import init_logger
+        from vllm.model_executor.layers.quantization.online import lm_head as olh
         from vllm.model_executor.layers.quantization.online.lm_head import (
             quantized_lm_head_copy,
         )
@@ -557,6 +558,10 @@ class Qwen4ExpMTP(nn.Module, SupportsHCSP, SupportsPP, Qwen4ExpMixtureOfExperts)
         )
         replace_parameter(rows, "weight", w)
         self._draft_rows_q = quantized_lm_head_copy(rows, quantization)
+        # vllm#59973 (e037067e) registers every copy against its source for
+        # re-derivation on reload; that strong reference would keep these BF16
+        # rows resident. The draft rows are not reloadable here, so unregister.
+        olh._SOURCES.pop(self._draft_rows_q, None)
         # The BF16 rows are no longer read; keep only their coordinates.
         self._draft_vocab_cache = (k, start, lo, hi, None)
         del rows, w
diff --git a/vllm/v1/worker/gpu/spec_decode/eagle/utils.py b/vllm/v1/worker/gpu/spec_decode/eagle/utils.py
index 63e999b7..5ca31bec 100644
--- a/vllm/v1/worker/gpu/spec_decode/eagle/utils.py
+++ b/vllm/v1/worker/gpu/spec_decode/eagle/utils.py
@@ -110,10 +110,14 @@ def load_eagle_model(target_model: nn.Module, vllm_config: VllmConfig) -> nn.Mod
         eagle_model, "has_own_lm_head", draft_lm_head, target_lm_head
     ):
         draft_head = target_lm_head
-        if speculative_config.draft_lm_head_quantization is not None:
-            draft_head = quantized_lm_head_copy(
-                target_lm_head, speculative_config.draft_lm_head_quantization
-            )
+        quantization = speculative_config.draft_lm_head_quantization
+        # A reduced-vocabulary drafter reads only its own
+        # rows, so it quantizes those itself (below) and keeps the shared head.
+        own_rows = quantization is not None and getattr(
+            eagle_model, "wants_own_draft_rows", lambda _head: False
+        )(target_lm_head)
+        if quantization is not None and not own_rows:
+            draft_head = quantized_lm_head_copy(target_lm_head, quantization)
         if draft_lm_head is not None:
             del eagle_model.lm_head
         eagle_model.lm_head = draft_head
@@ -128,6 +132,8 @@ def load_eagle_model(target_model: nn.Module, vllm_config: VllmConfig) -> nn.Mod
                 if sh is not None and hasattr(sh, "head"):
                     del sh.head
                     sh.head = draft_head
+        if own_rows:
+            eagle_model.quantize_draft_rows(quantization)
     elif speculative_config.draft_lm_head_quantization is not None:
         raise ValueError(
             "draft_lm_head_quantization needs a drafter that shares the target lm_head."
