+# : read routed-expert tensors with large preadv calls on a
+# thread pool instead of handing FusedMoE views of the shard's mmap. On GB10 the
+# per-expert copy_ from the mmap ran at ~214 MB/s on one core ( profile:
+# 74% of the engine core's load time). The bytes, names and yield order are
+# unchanged; every other tensor still comes from safe_open lazily, so tensors the
+# model drops (the PLE tables under host_file_gather) are never read.
+# QWEN38_BATCHED_LOAD=0 restores upstream behaviour.
+_QWEN38_EXPERT_NAME = re.compile(r"\.experts\.\d+\.")
+_QWEN38_ST_DTYPES = {
+    "F64": torch.float64,
+    "F32": torch.float32,
+    "F16": torch.float16,
+    "BF16": torch.bfloat16,
+    "F8_E4M3": torch.float8_e4m3fn,
+    "F8_E5M2": torch.float8_e5m2,
+    "I64": torch.int64,
+    "I32": torch.int32,
+    "I16": torch.int16,
+    "I8": torch.int8,
+    "U8": torch.uint8,
+    "BOOL": torch.bool,
+}
+
+
+def _qwen38_batched_load_enabled() -> bool:
+    return os.environ.get("QWEN38_BATCHED_LOAD", "1") != "0"
+
+
+def _qwen38_read_exact(fd: int, out: torch.Tensor, offset: int) -> None:
+    view = memoryview(out.numpy()).cast("B")
+    done = 0
+    while done < len(view):
+        n = os.preadv(fd, [view[done:]], offset + done)
+        if n <= 0:
+            raise OSError(f"short read at offset {offset + done}")
+        done += n
+
+
+def _qwen38_batched_expert_tensors(
+    st_file: str, names: list[str], f: Any
+) -> Generator[tuple[str, torch.Tensor], None, None]:
+    with open(st_file, "rb") as fh:
+        header_len = int.from_bytes(fh.read(8), "little")
+        header = json.loads(fh.read(header_len))
+    base = 8 + header_len
+    fast = {
+        name
+        for name in names
+        if _QWEN38_EXPERT_NAME.search(name)
+        and header.get(name, {}).get("dtype") in _QWEN38_ST_DTYPES
+    }
+    if not fast:
+        for name in names:
+            yield name, f.get_tensor(name)
+        return
+    threads = max(1, int(os.environ.get("QWEN38_BATCHED_LOAD_THREADS", "8")))
+    window = max(1, int(os.environ.get("QWEN38_BATCHED_LOAD_WINDOW_MB", "1024"))) << 20
+    fd = os.open(st_file, os.O_RDONLY)
+    with suppress(AttributeError, OSError):
+        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_SEQUENTIAL)
+
+    def read(name: str) -> torch.Tensor:
+        meta = header[name]
+        start, end = meta["data_offsets"]
+        buf = torch.empty(end - start, dtype=torch.uint8)
+        if end > start:
+            _qwen38_read_exact(fd, buf, base + start)
+        return buf.view(_QWEN38_ST_DTYPES[meta["dtype"]]).reshape(meta["shape"])
+
+    def nbytes(name: str) -> int:
+        start, end = header[name]["data_offsets"]
+        return end - start
+
+    order = [name for name in names if name in fast]
+    pending: collections.deque[tuple[str, concurrent.futures.Future, int]] = (
+        collections.deque()
+    )
+    executor = concurrent.futures.ThreadPoolExecutor(
+        max_workers=threads, thread_name_prefix="qwen38-load"
+    )
+    try:
+        nxt, inflight = 0, 0
+        for name in names:
+            if name not in fast:
+                yield name, f.get_tensor(name)
+                continue
+            while nxt < len(order) and (not pending or inflight < window):
+                size = nbytes(order[nxt])
+                pending.append((order[nxt], executor.submit(read, order[nxt]), size))
+                inflight += size
+                nxt += 1
+            head, future, size = pending.popleft()
+            assert head == name, (head, name)
+            tensor = future.result()
+            inflight -= size
+            yield name, tensor
+    finally:
+        executor.shutdown(wait=True, cancel_futures=True)
+        os.close(fd)
 
 
