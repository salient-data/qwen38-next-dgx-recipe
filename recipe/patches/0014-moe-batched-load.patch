+# : QWEN38_PINNED_EXPERT_COPY=1 stages each host-to-device
+# expert copy through one reusable pinned buffer, so the CUDA copy reads pinned
+# memory instead of a pageable (possibly file-backed) source. The copy stays
+# synchronous, so the buffer is free again when copy_ returns. Same bytes.
+_QWEN38_PINNED_STAGE: list[torch.Tensor] = []
+
+
+def _qwen38_expert_copy(dst: torch.Tensor, src: torch.Tensor) -> None:
+    import os
+
+    if (
+        os.environ.get("QWEN38_PINNED_EXPERT_COPY", "0") != "1"
+        or src.device.type != "cpu"
+        or dst.device.type != "cuda"
+        or not src.is_contiguous()
+        or src.numel() * src.element_size() < (64 << 10)
+    ):
+        dst.copy_(src)
+        return
+    nbytes = src.numel() * src.element_size()
+    if not _QWEN38_PINNED_STAGE or _QWEN38_PINNED_STAGE[0].numel() < nbytes:
+        _QWEN38_PINNED_STAGE[:] = [
+            torch.empty(max(nbytes, 64 << 20), dtype=torch.uint8, pin_memory=True)
+        ]
+    stage = _QWEN38_PINNED_STAGE[0][:nbytes].view(src.dtype).view(src.shape)
+    stage.copy_(src)
+    dst.copy_(stage)
+
 
